<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="015-student-lookup-challenges" author="luc">
        <comment>One-time email codes so a file number cannot leak a student record by itself</comment>
        <createTable tableName="student_lookup_challenges">
            <column name="id" type="BIGSERIAL">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="file_number" type="VARCHAR(20)">
                <constraints nullable="false"/>
            </column>
            <column name="code_hash" type="VARCHAR(60)">
                <constraints nullable="false"/>
            </column>
            <column name="lookup_token_hash" type="VARCHAR(64)"/>
            <column name="requester_ip" type="VARCHAR(64)"/>
            <column name="attempts" type="INT" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
            <column name="expires_at" type="TIMESTAMP WITH TIME ZONE">
                <constraints nullable="false"/>
            </column>
            <column name="verified_at" type="TIMESTAMP WITH TIME ZONE"/>
            <column name="consumed_at" type="TIMESTAMP WITH TIME ZONE"/>
            <column name="created_at" type="TIMESTAMP WITH TIME ZONE">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <createIndex indexName="idx_lookup_challenges_file_created" tableName="student_lookup_challenges">
            <column name="file_number"/>
            <column name="created_at"/>
        </createIndex>
        <createIndex indexName="idx_lookup_challenges_ip_created" tableName="student_lookup_challenges">
            <column name="requester_ip"/>
            <column name="created_at"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>

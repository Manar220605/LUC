<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="009-add-accepted-answer" author="luc">
        <addColumn tableName="questions">
            <column name="accepted_answer_id" type="BIGINT"/>
        </addColumn>

        <addForeignKeyConstraint
            baseTableName="questions"
            baseColumnNames="accepted_answer_id"
            constraintName="fk_questions_accepted_answer"
            referencedTableName="answers"
            referencedColumnNames="id"
            onDelete="SET NULL"/>
    </changeSet>

</databaseChangeLog>

{
  "realm": "luc",
  "displayName": "Lebanese University Connect",
  "enabled": true,
  "sslRequired": "external",
  "registrationAllowed": true,
  "registrationEmailAsUsername": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": true,
  "editUsernameAllowed": false,
  "bruteForceProtected": false,
  "internationalizationEnabled": false,
  "defaultLocale": "en",
  "supportedLocales": ["en"],
  "loginTheme": "keycloak",
  "accessTokenLifespan": 300,
  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 36000,
  "roles": {
    "realm": [
      {
        "name": "offline_access",
        "description": "${role_offline-access}",
        "composite": false,
        "clientRole": false
      },
      {
        "name": "uma_authorization",
        "description": "${role_uma_authorization}",
        "composite": false,
        "clientRole": false
      },
      {
        "name": "MEMBER",
        "description": "Default member role for all LUC users",
        "composite": false,
        "clientRole": false
      },
      {
        "name": "STUDENT",
        "description": "LU student with verified student ID",
        "composite": false,
        "clientRole": false
      },
      {
        "name": "ALUMNI",
        "description": "Verified LU alumni",
        "composite": false,
        "clientRole": false
      },
      {
        "name": "ADMIN",
        "description": "Platform administrator",
        "composite": false,
        "clientRole": false
      },
      {
        "name": "default-roles-luc",
        "description": "${role_default-roles}",
        "composite": true,
        "composites": {
          "realm": ["MEMBER", "offline_access", "uma_authorization"],
          "client": {
            "account": ["view-profile", "manage-account"]
          }
        },
        "clientRole": false
      }
    ]
  },
  "defaultRole": {
    "name": "default-roles-luc",
    "composite": true,
    "clientRole": false
  },
  "clients": [
    {
      "clientId": "luc-backend",
      "name": "LUC Backend",
      "description": "Bearer-only resource server for JWT validation",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "bearerOnly": true,
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "fullScopeAllowed": true,
      "redirectUris": [],
      "webOrigins": []
    },
    {
      "clientId": "luc-frontend",
      "name": "LUC Frontend",
      "description": "Public PKCE client for Next.js frontend",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "bearerOnly": false,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": false,
      "fullScopeAllowed": true,
      "redirectUris": [
        "http://localhost:3000/*",
        "http://localhost:3000/api/auth/callback/keycloak"
      ],
      "webOrigins": ["http://localhost:3000"],
      "attributes": {
        "pkce.code.challenge.method": "S256"
      }
    },
    {
      "clientId": "luc-admin-client",
      "name": "LUC Admin Client",
      "description": "Confidential service account for Keycloak Admin API",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "bearerOnly": false,
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "fullScopeAllowed": true,
      "secret": "dev-secret",
      "redirectUris": [],
      "webOrigins": []
    }
  ],
  "identityProviders": [
    {
      "alias": "linkedin",
      "displayName": "LinkedIn",
      "providerId": "linkedin-openid-connect",
      "enabled": true,
      "storeToken": false,
      "addReadTokenRoleOnCreate": false,
      "trustEmail": true,
      "linkOnly": false,
      "firstBrokerLoginFlowAlias": "first broker login",
      "config": {
        "clientId": "${KEYCLOAK_LINKEDIN_CLIENT_ID}",
        "clientSecret": "${KEYCLOAK_LINKEDIN_CLIENT_SECRET}",
        "defaultScope": "openid profile email",
        "clientAuthMethod": "client_secret_post",
        "syncMode": "IMPORT",
        "acceptsPromptNoneForwardFromClient": "false",
        "backchannelSupported": "false"
      }
    }
  ],
  "users": [
    {
      "username": "admin",
      "email": "admin@luc.local",
      "firstName": "Admin",
      "lastName": "User",
      "enabled": true,
      "emailVerified": true,
      "credentials": [
        {
          "type": "password",
          "value": "admin123",
          "temporary": false
        }
      ],
      "realmRoles": ["ADMIN", "MEMBER", "default-roles-luc"]
    },
    {
      "username": "service-account-luc-admin-client",
      "enabled": true,
      "emailVerified": false,
      "serviceAccountClientId": "luc-admin-client",
      "realmRoles": ["default-roles-luc"],
      "clientRoles": {
        "realm-management": ["manage-users", "view-users", "view-realm"]
      }
    }
  ]
}

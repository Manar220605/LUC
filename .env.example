# Postgres
POSTGRES_USER=luc
POSTGRES_PASSWORD=luc
POSTGRES_DB=luc

# Keycloak
KEYCLOAK_ADMIN_CLIENT_SECRET=dev-secret
KEYCLOAK_LINKEDIN_CLIENT_ID=
KEYCLOAK_LINKEDIN_CLIENT_SECRET=

# SMTP — used by Keycloak (forgot password) AND the backend (sign-up codes).
# Leave empty for Mailhog. For Mailgun sandbox:
# KEYCLOAK_SMTP_HOST=smtp.mailgun.org
# KEYCLOAK_SMTP_PORT=587
# KEYCLOAK_SMTP_STARTTLS=true
# KEYCLOAK_SMTP_AUTH=true
# KEYCLOAK_SMTP_FROM=noreply@YOUR-SANDBOX.mailgun.org
# KEYCLOAK_SMTP_USER=luc@YOUR-SANDBOX.mailgun.org
# KEYCLOAK_SMTP_PASSWORD=smtp-password-shown-once
KEYCLOAK_SMTP_HOST=
KEYCLOAK_SMTP_PORT=
KEYCLOAK_SMTP_FROM=
KEYCLOAK_SMTP_SSL=
KEYCLOAK_SMTP_STARTTLS=
KEYCLOAK_SMTP_AUTH=
KEYCLOAK_SMTP_USER=
KEYCLOAK_SMTP_PASSWORD=

# Frontend (next-auth)
NEXTAUTH_SECRET=replace-with-openssl-rand-base64-32

# Profile photos (optional). Docker Compose already sets this to /var/luc/uploads.
# LUC_UPLOADS_DIR=/var/luc/uploads

# Local embedder (all-MiniLM-L6-v2). Docker Compose sets this to http://embedder:8088.
# LUC_EMBEDDER_URL=http://localhost:8088
